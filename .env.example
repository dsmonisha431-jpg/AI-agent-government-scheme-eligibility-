NEXUS_BASE_URL=https://nexusapi.navigatelabs.ai
NEXUS_API_KEY=your_nexus_api_key_here
NEXUS_MODEL=nova-micro
NEXUS_EMBEDDING_MODEL=text-embedding-3-small

# Alternatively, use OpenAI by setting these and removing/clearing NEXUS_API_KEY.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
